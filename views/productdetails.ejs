<!DOCTYPE html>
<html lang="sv">

<head>
  <title>
    <%= product.productName %>
  </title>

  <link rel='stylesheet' href='/stylesheets/output.css' />
  <meta charset="UTF-8"> <!--Anger teckenuppsättningen på sidan-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--Gör sidan responsiv-->
 
 
</head>


<body class="font-serif">
    <header class="w-full flex items-center flex-wrap sm:flex-nowrap p-2">
        
        <a href="/">
            <img src="/images/FreakyFashionLogo.png" alt="Freaky Fashion Logotyp"
            class="w-full sm:w-80 lg:w-96 m-1 mr-5">
        </a> 
        
    <!-- Sökformulär för produkt -->
    <div class="flex flex-1 justify-start flex-wrap grow">
        <form action="/search" method="get" class="w-full">
            <div class="relative flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-search absolute left-2" viewBox="0 0 16 16">
                    <path
                        d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
                <input type="text" id="search" name="query" placeholder="Sök produkt" required
                 class="w-full sm:w-1/2 pl-8 h-8 rounded-lg border border-gray-400"> 

            </div>
        </form>
    </div>

    <div class="flex justify-end items-center flex-wrap ml-auto pl-10"> <!-- Lagt till margin och padding -->
        <a href="#"><img src="/images/heartfull.png" alt="Ifyllt hjärta" class="w-6 h-6 p-1"></a>
        <a href="#"><img src="/images/basket.png" alt="Kundkorg" class="w-6 h-6 p-1"></a>
    </div>
    </header>


<!-- Toppmenyn -->
<nav class="flex flex-col sm:flex-row lg:flex-row items-start my-2 pl-4">
    <a href="#" class="text-black no-underline pr-4">Nyheter</a>
    <a href="#" class="text-black no-underline pr-4">Topplistan</a>
    <a href="#" class="text-black no-underline pr-4">Rea</a>
    <a href="#" class="text-black no-underline">Kampanjer</a>
</nav>

    <main>
        <div class="productdetails flex flex-col sm:flex-row mx-2">
            <!-- Produktbild -->
            <img src="<%= product.productpicture %>" alt="<%= product.productName %>" class="produktbild w-full h-auto rounded-lg">
             <div class="produkt flex flex-col p-4">
                <!-- Produktnamn -->
                <div class="produktinfo mb-2">
                    <h2 class="text-lg font-bold"><%= product.productName %></h2>
                </div>
        
                <!-- Varumärke -->
                <div class="varumarke text-sm text-gray-600">
                    <%= product.brand %>
                </div>
                <div class="produktbeskrivning text-xs text-gray-500 my-2 sm:w-64">
                    <%= product.description %> 
                </div>
                <div class="pris text-lg font-bold">
                    <%= product.price %> SEK
                </div>
                <button type="button" class="w-full sm:w-[200px] border border-black rounded-lg bg-white py-2 mt-2">
                    Lägg i varukorgen
                </button>
            </div>
        </div>
        
        
          
        
        
        <div class="slideshow-container relative w-11/12 mx-auto overflow-hidden hidden sm:block">
            <div class="slide flex transition-transform duration-500 ease-in-out">
                <button class="prev absolute top-1/2 left-0 transform -translate-y-1/2 text-black bg-transparent border-none cursor-pointer z-10">&#10094;</button>
                <div class="slideshow flex">
                    <a href="#" class="product-card flex flex-col flex-none w-1/3 p-4 box-border no-underline text-black">
                        <img src="/images/black_tshirt.png" alt="Svart tshirt" class="produktbild w-full h-auto rounded">
                        <div class="produktinfo flex justify-between items-center text-left mb-2 text-sm">
                           <span>Svart T-shirt</span>
                            <span>199 SEK</span>
                        </div>
                        <div class="varumarke text-xs font-thin text-gray-600">
                            Levis
                        </div>                    
                    </a>
                    <a href="#" class="product-card flex flex-col flex-none w-1/3 p-4 box-border no-underline text-black">
                        <img src="/images/black_tshirt.png" alt="Svart tshirt" class="produktbild w-full h-auto rounded">
                        <div class="produktinfo flex justify-between items-center text-left mb-2 text-sm">
                           <span>Svart T-shirt</span>
                            <span>199 SEK</span>
                        </div>
                        <div class="varumarke text-xs font-thin text-gray-600">
                            Levis
                        </div>                    
                    </a>
                    <a href="#" class="product-card flex flex-col flex-none w-1/3 p-4 box-border no-underline text-black">
                        <img src="/images/black_tshirt.png" alt="Svart tshirt" class="produktbild w-full h-auto rounded">
                        <div class="produktinfo flex justify-between items-center text-left mb-2 text-sm">
                           <span>Svart T-shirt</span>
                            <span>199 SEK</span>
                        </div>
                        <div class="varumarke text-xs font-thin text-gray-600">
                            Levis
                        </div>                    
                    </a>
                    <a href="#" class="product-card flex flex-col flex-none w-1/3 p-4 box-border no-underline text-black">
                        <img src="/images/black_tshirt.png" alt="Svart tshirt" class="produktbild w-full h-auto rounded">
                        <div class="produktinfo flex justify-between items-center text-left mb-2 text-sm">
                           <span>Svart T-shirt</span>
                            <span>199 SEK</span>
                        </div>
                        <div class="varumarke text-xs font-thin text-gray-600">
                            Levis
                        </div>                    
                    </a>
                </div>    
                <button class="next absolute top-1/2 right-0 transform -translate-y-1/2 text-black bg-transparent border-none cursor-pointer z-10">&#10095;</button>
            </div>
        </div>
        
       
        <script>
            let currentIndex = 0;
        
            function showSlides() {
                const slides = document.querySelector('.slideshow');
                const totalSlides = document.querySelectorAll('.product-card').length;
        
                if (currentIndex >= totalSlides - 3) {
                    currentIndex = totalSlides - 3;
                }
        
                slides.style.transform = `translateX(-${currentIndex * 33.333}%)`;
            }
        
            document.querySelector('.next').addEventListener('click', () => {
                const totalSlides = document.querySelectorAll('.product-card').length;
                if (currentIndex < totalSlides - 3) {
                    currentIndex++;
                    showSlides();
                }
            });
        
            document.querySelector('.prev').addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                    showSlides();
                }
            });
        
            // Initialize the slides
            showSlides();
        </script>
        

      
<div class="services">
    <ul class="grid grid-cols-1 gap-2 mt-5 sm:grid-cols-2 lg:grid-cols-4 px-10">
        <li class="flex items-center list-none whitespace-nowrap">
            <img src="/images/ikon1.png" alt="Gratis frakt och returer" class="w-6 h-6 mr-4">
            Gratis frakt och returer
        </li>
        <li class="flex items-center list-none">
            <img src="/images/ikon2.png" alt="Expressfrakt" class="w-6 h-6 mr-4">
            Expressfrakt
        </li>
        <li class="flex items-center list-none">
            <img src="/images/ikon3.png" alt="Säkra betalningar" class="w-6 h-6 mr-4">
            Säkra betalningar
        </li>
        <li class="flex items-center list-none">
            <img src="/images/ikon4.png" alt="Nyheter varje dag" class="w-6 h-6 mr-4">
            Nyheter varje dag
        </li>
    </ul>
</div>


         
    </main>

    <footer>

        <!-- Footer menyn (Visas på större skärmar) -->
        <nav class="footer_meny hidden sm:block bg-gray-200 border border-black p-4">
            <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <li>
                    <h2 class="text-xl font-bold mb-2">Shopping</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Trenchcoats</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Kappa</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Pufferjackor</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Vinterjackor</a></li>
                    </ul>
                </li>
        
                <li>
                    <h2 class="text-xl font-bold mb-2">Mina sidor</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Mina ordrar</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Mitt konto</a></li>
                    </ul>
                </li>
        
                <li>
                    <h2 class="text-xl font-bold mb-2">Kundtjänst</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Returpolicy</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Integritetspolicy</a></li>
                    </ul>
                </li>
            </ul>
        </nav>
        <!-- Accordion gjord med hjälp av Chat Gpt -->
    <div class="block sm:hidden" x-data="{ openAccordion: 1 }">
        <div class="">
            <h2>
                <button @click="openAccordion === 1 ? openAccordion = 0 : openAccordion = 1"
                    class="w-full text-left px-4 py-2 bg-blue-200">
                    Shopping
                </button>
            </h2>
            <div x-show="openAccordion === 1" class="">
                <ul class="list-none">
                    <li><a href="#" class="text-black no-underline">Trenchcoats</a></li>
                    <li><a href="#" class="text-black no-underline">Kappa</a></li>
                    <li><a href="#" class="text-black no-underline">Pufferjackor</a></li>
                    <li><a href="#" class="text-black no-underline" >Vinterjackor</a></li>
                </ul>
            </div>
        </div>
        <div class="">
            <h2>
                <button @click="openAccordion === 2 ? openAccordion = 0 : openAccordion = 2"
                    class="w-full text-left px-4 py-2 bg-gray-200">
                    Mina sidor
                </button>
            </h2>
            <div x-show="openAccordion === 2" class="">
                <ul class="list-none">
                    <li><a href="#" class="text-black no-underline">Mina ordrar</a></li>
                    <li><a href="#" class="text-black no-underline">Mitt konto</a></li>
                </ul>
            </div>
        </div>
        <div>
            <h2>
                <button @click="openAccordion === 3 ? openAccordion = 0 : openAccordion = 3"
                    class="w-full text-left px-4 py-2 bg-gray-200">
                    Kundtjänst
                </button>
            </h2>
            <div x-show="openAccordion === 3" class="">
                <ul class="list-none">
                    <li><a href="#" class="text-black no-underline">Returpolicy</a></li>
                    <li><a href="#" class="text-black no-underline">Integritetspolicy</a></li>
                </ul>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    

    
    

</body>

</html>
