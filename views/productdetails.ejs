<main>
<div class="productdetails flex flex-col lg:flex-row gap-4 mx-auto max-w-4xl px-10">
        <!-- Produktbild -->
        <img src="<%= product.productPicture %>" alt="<%= product.productName %>"
            class="w-full md:w-32 lg:w-96 h-48 object-cover rounded-lg shrink-0" />
        <div class="produkt flex flex-col p-4">
            <!-- Produktnamn -->
            <div class="produktinfo mb-2">
                <h2 class="text-lg font-bold">
                    <%= product.productName %>
                </h2>
            </div>

            <!-- Varumärke -->
            <div class="varumarke text-sm text-gray-600">
                <%= product.brand %>
            </div>
            <div class="produktbeskrivning text-xs text-gray-500 my-2 sm:w-64">
                <%= product.description %>
            </div>
            <div class="pris text-lg font-bold">
                <%= product.price %> SEK
            </div>
            <button type="button" class="w-full sm:w-[200px] border border-black rounded-lg bg-white py-2 mt-2">
                Lägg i varukorgen
            </button>
        </div>
    </div>



    <div class="w-1/2 mx-auto hidden sm:block mb-8">
        <h2 class="text-center">Liknande produkter</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

            <% similarProducts.slice(0,3).forEach(product=> { %>
                <a href="/productDetails/<%= product.articleNumber %>" class="flex flex-col no-underline p-3 text-black">

                    <img src="<%= product.productPicture %>" alt="<%= product.productName %>"
                        class=" h-16 w-full rounded">

                    <div class="mt-2 flex justify-between text-sm">
                        <span>
                            <%= product.productName %>
                        </span>
                        <span>
                            <%= product.price %> SEK
                        </span>
                    </div>

                    <div class="text-xs text-gray-600">
                        <%= product.brand %>
                    </div>

                </a>
                <% }); %>

        </div>
    </div>





</main>