<main>    <div class="flex-1 p-4">
            <!-- Rubrik och knappar -->
            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl">Kategorier</h2>
                <div class="flex space-x-2">
            
                <a href="/admin/products/newcategory" class="border border-black p-2 text-black rounded">Ny kategori</a>
                </div>
            </div>
    
 <!-- Tabell -->
    <table id="productTable" class="w-full table-fixed ">
        <thead class="bg-white text-left">
            <tr>
                <th class="w-1/2 border border-black bg-gray-300 p-2">Produktnamn</th>
            </tr>
        </thead>
        <tbody id="productlist">
            <% categories.forEach(category=> { %>
                <tr>
                    <td class="border border-black p-2">
                        <%= category.name %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

</main>