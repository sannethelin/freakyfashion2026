<main>

    <div class="p-4">

        <div class="products mb-5">
            <h3 class="text-xl">Ny produkt</h3>
        </div>

        <form id="new-product-form" action="/add-product" method="POST" enctype="multipart/form-data" class="space-y-4">

            <div>
                <label for="articleNumber" class="block">Artikelnr</label>
                <input type="number" id="articleNumber" name="articleNumber" placeholder="Ange artikelnummer" required
                    maxlength="25" class="border border-gray-400 p-2 w-full">
            </div>

            <div>
                <label for="productName" class="block">Namn</label>
                <input type="text" id="productName" name="productName" placeholder="Ange namn" required maxlength="50"
                    class="border border-gray-400 p-2 w-full">
            </div>

            <div>
                <label for="description" class="block">Beskrivning</label>
                <textarea id="description" name="description" placeholder="Ange beskrivning" rows="4"
                    class="border border-gray-400 p-2 w-full"></textarea>
            </div>

            <div>
                <label for="productPicture" class="block">Bild (URL)</label>
                <input type="file" id="productPicture" name="productPicture" accept="image/png, image/jpeg"
                    class="border border-gray-400 p-2 w-full">
            </div>

            <div>
                <label for="sku" class="block">SKU</label>
                <input type="text" id="sku" name="sku" pattern="[A-Za-z]{3}[0-9]{3}" placeholder="Ange SKU (AAA000)"
                    class="border border-gray-400 p-2 w-full">
            </div>

            <div>
                <label for="brand" class="block">Märke</label>
                <input type="text" id="brand" name="brand" placeholder="Ange Märke" required
                    class="border border-gray-400 p-2 w-full">
            </div>

            <div>
                <label for="price" class="block">Pris</label>
                <input type="number" id="price" name="price" placeholder="Ange pris"
                    class="border border-gray-400 p-2 w-full">
            </div>
            <div class="category">
                <label for="categoryId" class="block mb-2">Kategori</label>

                <select id="categoryId" name="categoryId" required class="border border-gray-400 p-2 w-full">
                    <option value="">Välj kategori</option>

                    <% categories.forEach(category=> { %>
                        <option value="<%= category.id %>">
                            <%= category.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit" class="addproduct inline-block bg-white text-black border border-black p-2 rounded">
                Lägg till
            </button>

        </form>
</main>