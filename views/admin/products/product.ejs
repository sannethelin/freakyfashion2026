<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administration</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="font-serif">
    <div class="bg-gray-800 text-white text-lg p-2">Administration</div>
    
    <div class="flex p-0">
        <aside class="w-1/6 bg-gray-300 border border-black h-screen p-4">
            <ul class="list-none p-0">
                <li class="text-black">Produkter</li>
            </ul>
        </aside>
        <main class="flex-1 p-4">
            <!-- Rubrik och knappar -->
            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl">Produkter</h2>
                <div class="flex space-x-2">
                    <a href="#" class="border border-black p-2 text-black rounded">Ladda produkter</a>
                    <a href="/admin/products/new" class="border border-black p-2 text-black rounded">Ny produkt</a>
                </div>
            </div>
        
            <!-- Formulär (tabell) -->
            <table class="w-full border border-collapse">
                <thead>
                    <tr class="bg-gray-500 text-left">
                        <th class="border border-black p-2">Namn</th>
                        <th class="border border-black p-2">SKU</th>
                        <th class="border border-black p-2">Pris</th>
                        <th class="border border-black p-2"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="bg-gray-200 border-black border">
                        <td class="border border-black p-2">Svart T-shirt</td>
                        <td class="border border-black p-2">AAA111</td>
                        <td class="border border-black p-2">199</td>
                        <td class="p-2 flex justify-center">
                            <!-- Ikoner för redigering -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                class="bi bi-pencil-square cursor-pointer" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                <path fill-rule="evenodd"
                                    d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                class="bi bi-trash-fill cursor-pointer" viewBox="0 0 16 16">
                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                            </svg>
                        </td>
                    </tr>
                    <tr class="bg-gray-300 border-black border">
                        <td class="border border-black p-2">Vit T-shirt</td>
                        <td class="border border-black p-2">BBB111</td>
                        <td class="border border-black p-2">199</td>
                        <td class="p-2 flex justify-center">
                            <!-- Ikoner för redigering -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                class="bi bi-pencil-square cursor-pointer" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                <path fill-rule="evenodd"
                                    d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                class="bi bi-trash-fill cursor-pointer" viewBox="0 0 16 16">
                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                            </svg>
                        </td>
                    </tr>
                </tbody>
            </table>
        </main>
        
    </div>
</body>

</html>
