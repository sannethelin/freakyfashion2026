<main>
        <div class="flex-1 p-4">
            <!-- Rubrik och knappar -->
            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl">Produkter</h2>
                <div class="flex space-x-2">
            
                <a href="/admin/products/newproduct" class="border border-black p-2 text-black rounded">Ny produkt</a>
                </div>
            </div>
    <!-- Tabell -->
    <table id="productTable" class="w-full table-fixed ">
        <thead class="bg-white text-left">
            <tr>
                <th class="w-1/2 border border-black bg-gray-300 p-2">Produktnamn</th>
                <th class="w-1/4 border border-black bg-gray-300 p-2">SKU</th>
                <th class="w-1/4 border border-black bg-gray-300 p-2">Pris</th>
            </tr>
        </thead>
        <tbody id="productlist">
            <% products.forEach(product=> { %>
                <tr>
                    <td class="border border-black p-2">
                        <%= product.productName %>
                    </td>
                    <td class="border border-black p-2">
                        <%= product.articleNumber %>
                    </td>
                    <td class="border border-black p-2">
                        <%= product.price %> SEK
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</main>