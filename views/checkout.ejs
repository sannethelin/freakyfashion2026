<!DOCTYPE html>
<html lang="sv">

<head>
  <title>
    <%= title %>
  </title>

  <link rel='stylesheet' href='/stylesheets/output.css' />
  <meta charset="UTF-8"> <!--Anger teckenuppsättningen på sidan-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--Gör sidan responsiv-->
</head>


<body class="font-serif">
    <header class="w-full flex items-center flex-wrap p-2">
    
        <a href="/index">
            <img src="images/FreakyFashionLogo.png" alt="Freaky Fashion Logotyp"
            class="w-full sm:w-80 lg:w-96 m-1 mr-5">
        </a> 
        
    <!-- Sökformulär för produkt -->
    <div class="flex flex-1 justify-start flex-wrap">
        <form action="/search" method="get" class="w-full">
            <div class="relative flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-search absolute left-2" viewBox="0 0 16 16">
                    <path
                        d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
                <input type="text" id="search" name="query" placeholder="Sök produkt" required
                 class="w-full sm:w-1/2 pl-8 h-8 rounded-lg border border-gray-400"> 
  
            </div>
        </form>
    </div>
  
    <div class="flex justify-end items-center flex-wrap ml-auto pl-10"> <!-- Lagt till margin och padding -->
        <a href="#"><img src="images/heartfull.png" alt="Ifyllt hjärta" class="w-6 h-6 p-1"></a>
        <a href="/checkout"><img src="images/basket.png" alt="Kundkorg" class="w-6 h-6 p-1"></a>
    </div>
    </header>


<!-- Toppmenyn -->
<nav class="flex flex-col sm:flex-row lg:flex-row items-start my-2 pl-4">
    <a href="#" class="text-black no-underline pr-4 transition-transform duration-300 hover:text-lg">Nyheter</a>
    <a href="#" class="text-black no-underline pr-4 transition-transform duration-300 hover:text-lg">Topplistan</a>
    <a href="#" class="text-black no-underline pr-4 transition-transform duration-300 hover:text-lg">Rea</a>
    <a href="#" class="text-black no-underline transition-transform duration-300 hover:text-lg">Kampanjer</a>
  </nav>

    <main>
            <h3 class="text-center">Kassa</h3></div>
             <!-- Tabell för mobilskärmar --><table class="w-full border border-black  mx-4 my-2 text-left sm:hidden">

                <tr class="">
                    <td>1 x Svart t-shirt</td>
                    <td class="total text-right">199 kr</td>
                </tr>
                <tr class="border-b">
                    <td class="price text-gray-500">199 kr</td>
                </tr>
                <tr>
                    <td>2 x vit t-shirt</td>
                    <td class="total text-right">398 kr</td>
                </tr>
                <tr>
                    <td class="price text-gray-500">199 kr</td>
                    <td></td>
                </tr>
            </table>


            <!-- Tabell för större skärmar -->
            <div class="m-3"> <!-- Wrapper med margin -->
                <table class="checkout-desktop hidden sm:block bg-black border-collapse">
                    <thead>
                        <tr class="bg-gray-400">
                            <th class="border border-black text-left w-1/2">Produkt</th>
                            <th class="border border-black text-left w-1/4">Antal</th>
                            <th class="border border-black text-left w-1/4">Pris</th>
                            <th class="border border-black text-left w-1/4">Totalt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="bg-gray-200">
                            <td class="border border-black">Svart T-shirt</td>
                            <td class="border border-black">1</td>
                            <td class="border border-black">199 kr</td>
                            <td class="border border-black">199 kr</td>
                        </tr>
                        <tr class="bg-gray-300">
                            <td class="border border-black">Vit T-shirt</td>
                            <td class="border border-black">2</td>
                            <td class="border border-black">199 kr</td>
                            <td class="border border-black">398 kr</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            

            
            <div class="kunduppgifter m-2">
    <h2 class="mb-3 mt-10">Kunduppgifter</h2>
    <form class="uppgifter mb-5">
        <div class="flex flex-col sm:flex-row mb-3">
            <div class="flex flex-col mr-2 w-full sm:w-1/2">
                <label for="firstname" class="mb-1 text-left">Förnamn:</label>
                <input type="text" id="firstname" name="firstname" required class="w-full p-2 border border-gray-300 rounded" />
            </div>
            <div class="flex flex-col w-full sm:w-1/2">
                <label for="lastname" class="mb-1 text-left">Efternamn:</label>
                <input type="text" id="lastname" name="lastname" required class="w-full p-2 border border-gray-300 rounded" />
            </div>
        </div>
        <label for="email" class="block mb-1 text-left">E-post:</label>
        <input type="email" id="email" name="email" required class="w-full p-2 border border-gray-300 rounded" />
    </form>
</div>

                <fieldset class="adress p-4 mb-4 border border-black rounded m-20">
                    <legend class="font-bold text-center">Adress</legend>
            
                    <label for="street" class="block mb-1 text-left">Gata:</label>
                    <input type="text" id="street" name="street" required class="w-4/5 p-2 border border-gray-300 rounded"/>
            
                    <label for="postalcode" class="block mb-1 text-left">Postnummer:</label>
                    <input type="text" id="postalcode" name="postalcode" required class="w-1/4 text-left p-2 border border-gray-300 rounded" />
            
                    <label for="city" class="block mb-1 text-left">Stad:</label>
                    <input type="text" id="city" name="city" required class="w-1/2 p-2 border border-gray-300 rounded" />
                </fieldset>
            
            
            <div class="nyhetsbrev-container pt-8 w-72 mx-auto text-center">
                <label for="nyhetsbrev" class="checkbox-label mb-8">
                    <input type="checkbox" id="nyhetsbrev" name="nyhetsbrev" class="mr-2"> Jag vill ta emot nyhetsbrev
                </label>
            </div>
            <div class="text-center mt-4">
                <!-- Köp-knappen -->
                <button type="button" class="kop-knapp bg-black text-white py-2 px-4 rounded mx-auto">Köp</button>
            </div>
            

      
<div class="services">
    <ul class="grid grid-cols-1 gap-2 mt-5 sm:grid-cols-2 lg:grid-cols-4 px-10">
        <li class="flex items-center list-none whitespace-nowrap">
            <img src="images/ikon1.png" alt="Gratis frakt och returer" class="w-6 h-6 mr-4">
            Gratis frakt och returer
        </li>
        <li class="flex items-center list-none">
            <img src="images/ikon2.png" alt="Expressfrakt" class="w-6 h-6 mr-4">
            Expressfrakt
        </li>
        <li class="flex items-center list-none">
            <img src="images/ikon3.png" alt="Säkra betalningar" class="w-6 h-6 mr-4">
            Säkra betalningar
        </li>
        <li class="flex items-center list-none">
            <img src="images/ikon4.png" alt="Nyheter varje dag" class="w-6 h-6 mr-4">
            Nyheter varje dag
        </li>
    </ul>
</div>



    </main>

    <footer>

        <!-- Footer menyn (Visas på större skärmar) -->
        <nav class="footer_meny hidden sm:block bg-gray-200 border border-black p-4">
            <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <li>
                    <h2 class="text-xl font-bold mb-2">Shopping</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Trenchcoats</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Kappa</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Pufferjackor</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Vinterjackor</a></li>
                    </ul>
                </li>
        
                <li>
                    <h2 class="text-xl font-bold mb-2">Mina sidor</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Mina ordrar</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Mitt konto</a></li>
                    </ul>
                </li>
        
                <li>
                    <h2 class="text-xl font-bold mb-2">Kundtjänst</h2>
                    <ul class="flex flex-col space-y-2 p-0">
                        <li><a href="#" class="text-black no-underline hover:underline">Returpolicy</a></li>
                        <li><a href="#" class="text-black no-underline hover:underline">Integritetspolicy</a></li>
                    </ul>
                </li>
            </ul>
        </nav>
        
  <!-- Accordion gjord med hjälp av Chat Gpt -->
  <div class="block sm:hidden" x-data="{ openAccordion: 1 }">
    <div class="">
        <h2>
            <button @click="openAccordion === 1 ? openAccordion = 0 : openAccordion = 1"
                class="w-full text-left px-4 py-2 bg-blue-200">
                Shopping
            </button>
        </h2>
        <div x-show="openAccordion === 1" class="">
            <ul class="list-none">
                <li><a href="#" class="text-black no-underline">Trenchcoats</a></li>
                <li><a href="#" class="text-black no-underline">Kappa</a></li>
                <li><a href="#" class="text-black no-underline">Pufferjackor</a></li>
                <li><a href="#" class="text-black no-underline" >Vinterjackor</a></li>
            </ul>
        </div>
    </div>
    <div class="">
        <h2>
            <button @click="openAccordion === 2 ? openAccordion = 0 : openAccordion = 2"
                class="w-full text-left px-4 py-2 bg-gray-200">
                Mina sidor
            </button>
        </h2>
        <div x-show="openAccordion === 2" class="">
            <ul class="list-none">
                <li><a href="#" class="text-black no-underline">Mina ordrar</a></li>
                <li><a href="#" class="text-black no-underline">Mitt konto</a></li>
            </ul>
        </div>
    </div>
    <div>
        <h2>
            <button @click="openAccordion === 3 ? openAccordion = 0 : openAccordion = 3"
                class="w-full text-left px-4 py-2 bg-gray-200">
                Kundtjänst
            </button>
        </h2>
        <div x-show="openAccordion === 3" class="">
            <ul class="list-none">
                <li><a href="#" class="text-black no-underline">Returpolicy</a></li>
                <li><a href="#" class="text-black no-underline">Integritetspolicy</a></li>
            </ul>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>


    
    

</body>

</html>